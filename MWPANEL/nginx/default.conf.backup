# HTTP to HTTPS redirect for all domains
server {
    listen 80;
    server_name plataforma.mundoworld.school;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        allow all;
    }

    location / {
        return 301 https://$server_name$request_uri;
    }
}

# MW Panel - plataforma.mundoworld.school
server {
    listen 443 ssl;
    http2 on;
    server_name plataforma.mundoworld.school;

    ssl_certificate /etc/nginx/ssl/cloudflare/cert.pem;
    ssl_certificate_key /etc/nginx/ssl/cloudflare/key.pem;
    
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    client_max_body_size 100M; # Soporta chunks grandes para archivos de hasta 10GB
    client_body_timeout 300;
    client_header_timeout 300;
    client_body_buffer_size 128k;

    location / {
        # Production mode - serve static files with SPA routing
        root /usr/share/nginx/html;
        # SPA routing: serve index.html for all non-file routes
        try_files $uri $uri/ @fallback;
        index index.html;
        
        # Security headers
        add_header X-Content-Type-Options nosniff;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin";
        
        # Cloudflare cache fix headers
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
    }

    # Cache control for HTML files
    location ~* \.html$ {
        root /usr/share/nginx/html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
        add_header X-Content-Type-Options nosniff;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin";
    }

    # Fallback location for SPA routing
    location @fallback {
        root /usr/share/nginx/html;
        try_files /index.html =404;
        
        # Security headers for SPA fallback
        add_header X-Content-Type-Options nosniff;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin";
        
        # No cache for SPA index.html fallback
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
    }

    # Static file rules for production - CACHE BUSTING WITH QUERY STRING
    # Direct uploads serving from nginx
    location ^~ /uploads/ {
        alias /usr/share/nginx/uploads/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
    
    # Static file serving for uploads (profile photos, etc.) - MUST OVERRIDE LOCATION /
    # Backend API integration
    location ^~ /api/uploads/ {
        proxy_pass http://172.18.0.6:3000/uploads/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Cache uploaded files for better performance
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location ~* \.(js|css)$ {
        root /usr/share/nginx/html;
        
        # Cache busting: serve file without query string but apply different cache headers
        set $file_path $uri;
        try_files $file_path =404;
        
        # Default long cache
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options nosniff;
        
        # Shorter cache for files with version query params (cache busting)
        if ($args ~ "^v=") {
            expires 5m;
            add_header Cache-Control "public, max-age=300";
        }
    }

    location ~* ^(?!/api/uploads/).*\.(png|jpg|jpeg|gif|ico|svg)$ {
        root /usr/share/nginx/html;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPECIFIC: Blog media upload-chunk endpoint - must come before general /api/
    location /api/blog-media/upload-chunk {
        # Enhanced configuration for large chunked uploads
        client_max_body_size 200M;           # Double the general limit for chunks
        client_body_buffer_size 1M;          # Larger buffer for 5MB chunks
        client_body_timeout 900;             # 15 minutes for large chunks
        
        # Proxy settings optimized for uploads
        proxy_pass http://172.18.0.6:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Critical upload settings (TESTING: Enable buffering for multipart/form-data)
        proxy_request_buffering on;          # Enable buffering for multipart compatibility
        proxy_buffering off;                 # Keep response buffering disabled
        proxy_read_timeout 900;              # 15 minutes for processing
        proxy_connect_timeout 300;           # 5 minutes to connect
        proxy_send_timeout 900;              # 15 minutes to send
        
        # Debug headers
        proxy_set_header X-Debug-Upload "chunk-endpoint";
        proxy_set_header X-Content-Length $content_length;
    }

    # Blog URL Rewrites - Fix for frontend /api/blog/* calls
    location /api/blog/posts {
        rewrite ^/api/blog/posts(.*)$ /api/blog-posts$1 last;
    }
    
    location /api/blog/categories {
        rewrite ^/api/blog/categories(.*)$ /api/blog-categories$1 last;
    }
    
    location /api/blog/stats {
        rewrite ^/api/blog/stats(.*)$ /api/blog-posts/stats$1 last;
    }

    # CRITICAL: Backend API proxy (general)
    location /api/ {
        # Let NestJS backend handle CORS - no duplicate headers
        proxy_pass http://172.18.0.6:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 86400;
        proxy_connect_timeout 300;
        proxy_send_timeout 300;
        proxy_request_buffering off;
        proxy_buffering off;
        client_body_buffer_size 128k;
        client_body_timeout 300;
    }
}
# HTTP to HTTPS redirect for mocks.mundoworld.school
server {
    listen 80;
    server_name mocks.mundoworld.school;
    return 301 https://$server_name$request_uri;
}

# Cambridge Mocks - mocks.mundoworld.school HTTPS
server {
    listen 443 ssl;
    http2 on;
    server_name mocks.mundoworld.school;

    ssl_certificate /etc/nginx/ssl/cloudflare/cert.pem;
    ssl_certificate_key /etc/nginx/ssl/cloudflare/key.pem;
    
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # Security headers
    add_header Strict-Transport-Security "max-age=63072000; includeSubdomains; preload";
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options DENY;
    add_header X-XSS-Protection "1; mode=block";
    add_header Referrer-Policy strict-origin-when-cross-origin;

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
    gzip_min_length 1000;
    
    # Proxy to Next.js app
    location / {
        proxy_pass http://172.20.0.2:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    # Handle API routes
    location /api/ {
        proxy_pass http://172.20.0.2:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Handle _next static files  
    location /_next/ {
        proxy_pass http://172.20.0.2:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Static files cache
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        proxy_pass http://172.20.0.2:3001;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
