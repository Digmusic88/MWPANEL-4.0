{
  "name": "mw-panel-backend",
  "version": "2.0.0",
  "description": "MW Panel - School Management System Backend",
  "author": "MW Panel Team",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:ci": "jest --coverage --ci --reporters=default --reporters=jest-junit",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm migration:generate -- -d src/database/data-source.ts",
    "migration:run": "npm run typeorm migration:run -- -d src/database/data-source.ts",
    "migration:revert": "npm run typeorm migration:revert -- -d src/database/data-source.ts",
    "seed": "ts-node src/database/seeds/run-seed.ts",
    "seed:run": "ts-node src/database/seeds/run-seed.ts",
    "seed:dua": "ts-node src/database/seeds/dua-seed-runner.ts",
    "generate:embeddings": "ts-node scripts/generate-embeddings.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.56.0",
    "@azure-rest/ai-content-safety": "^1.0.0",
    "@azure/core-auth": "^1.7.2",
    "@huggingface/inference": "^2.8.1",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.4.19",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^7.0.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^10.0.0",
    "@nestjs/websockets": "^10.4.19",
    "@tensorflow/tfjs-node": "^4.15.0",
    "@types/compression": "^1.8.1",
    "@types/moment-timezone": "^0.5.13",
    "@types/uuid": "^10.0.0",
    "@types/xlsx": "^0.0.35",
    "@willsoto/nestjs-prometheus": "^6.0.2",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.11.0",
    "bcrypt": "^5.1.0",
    "cache-manager": "^7.0.1",
    "cache-manager-redis-store": "^3.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "compression": "^1.8.1",
    "exceljs": "^4.4.0",
    "express-rate-limit": "^8.0.1",
    "google-auth-library": "^9.14.1",
    "googleapis": "^142.0.0",
    "handlebars": "^4.7.8",
    "helmet": "^7.0.0",
    "helmet-csp": "^4.0.0",
    "ioredis": "^5.3.2",
    "mjml": "^4.15.3",
    "moment-timezone": "^0.6.0",
    "multer": "^1.4.5-lts.1",
    "nest-winston": "^1.10.2",
    "nodemailer": "^6.10.1",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdfkit": "^0.15.2",
    "pg": "^8.11.0",
    "prom-client": "^15.1.3",
    "rate-limiter-flexible": "^7.1.1",
    "reflect-metadata": "^0.1.13",
    "resend": "^3.5.0",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.3",
    "socket.io": "^4.8.1",
    "typeorm": "^0.3.16",
    "uuid": "^11.1.0",
    "vm2": "^3.9.19",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.14",
    "@types/mjml": "^4.7.4",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.3.1",
    "@types/nodemailer": "^6.4.17",
    "@types/passport-jwt": "^3.0.8",
    "@types/passport-local": "^1.0.35",
    "@types/pdfkit": "^0.12.12",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^5.59.11",
    "@typescript-eslint/parser": "^5.59.11",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^29.5.0",
    "jest-junit": "^16.0.0",
    "prettier": "^2.8.8",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  }
}
