# Redis Cache Configuration
# Add these to your .env file

# Cache store type (redis or memory)
CACHE_STORE=redis

# Redis connection for cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CACHE_DB=1                    # Use different DB than sessions (0)

# Default cache TTL in seconds
CACHE_TTL=300                       # 5 minutes default

# Cache key prefix
CACHE_KEY_PREFIX=mw-cache:

# Cache TTLs for different data types (in seconds)
CACHE_USERS_TTL=300                 # 5 minutes
CACHE_STUDENTS_TTL=600              # 10 minutes
CACHE_COMPETENCIES_TTL=3600         # 1 hour (rarely change)
CACHE_EVALUATIONS_TTL=300           # 5 minutes
CACHE_GROUPS_TTL=1800               # 30 minutes
CACHE_SUBJECTS_TTL=3600             # 1 hour
CACHE_YEARS_TTL=7200                # 2 hours
CACHE_DASHBOARD_TTL=120             # 2 minutes
CACHE_REPORTS_TTL=600               # 10 minutes
CACHE_TYPEQUEST_TTL=300             # 5 minutes

# Cache invalidation
CACHE_CASCADE_INVALIDATION=true     # Invalidate related caches

# Performance settings
CACHE_WARM_ON_STARTUP=true          # Warm cache on app start
CACHE_BATCH_SIZE=100                # Batch size for operations
CACHE_ENABLE_STATS=true             # Enable cache statistics
CACHE_COMPRESS=true                 # Compress large values
CACHE_COMPRESS_THRESHOLD=1024       # Compress if larger than 1KB

# Cache tags
CACHE_TAGS_ENABLED=true             # Enable cache tagging