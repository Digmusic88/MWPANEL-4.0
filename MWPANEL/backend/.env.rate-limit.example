# Rate Limiting Configuration
# Add these to your .env file

# Global Rate Limiting
RATE_LIMIT_TTL=60                    # Time window in seconds (default: 60)
RATE_LIMIT_MAX=100                   # Max requests per window (default: 100)

# Endpoint-specific limits
RATE_LIMIT_LOGIN_TTL=300             # Login window: 5 minutes
RATE_LIMIT_LOGIN_MAX=5               # Max login attempts: 5
RATE_LIMIT_REGISTER_TTL=3600         # Register window: 1 hour
RATE_LIMIT_REGISTER_MAX=3            # Max registrations: 3
RATE_LIMIT_PASSWORD_TTL=3600         # Password reset window: 1 hour
RATE_LIMIT_PASSWORD_MAX=3            # Max password resets: 3
RATE_LIMIT_API_TTL=60                # API window: 1 minute
RATE_LIMIT_API_MAX=60                # Max API calls: 60
RATE_LIMIT_UPLOAD_TTL=300            # Upload window: 5 minutes
RATE_LIMIT_UPLOAD_MAX=10             # Max uploads: 10
RATE_LIMIT_REPORTS_TTL=600           # Reports window: 10 minutes
RATE_LIMIT_REPORTS_MAX=5             # Max reports: 5

# DDoS Protection
RATE_LIMIT_USE_REDIS=true            # Use Redis for distributed rate limiting
RATE_LIMIT_TRUST_PROXY=true          # Trust proxy headers (behind Nginx)
RATE_LIMIT_WHITELIST=                # Comma-separated IPs to whitelist
RATE_LIMIT_BLACKLIST=                # Comma-separated IPs to blacklist

# Advanced Features
RATE_LIMIT_FINGERPRINT=true          # Enable request fingerprinting
RATE_LIMIT_BACKOFF=true              # Enable exponential backoff
RATE_LIMIT_BACKOFF_MULTIPLIER=1.5    # Backoff multiplier
RATE_LIMIT_CAPTCHA_THRESHOLD=10      # Failed attempts before CAPTCHA