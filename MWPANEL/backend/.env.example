# Application
NODE_ENV=production
DOMAIN=panel.tuescuela.com
SSL_EMAIL=admin@tuescuela.com

# Database
DB_NAME=mwpanel
DB_USER=mwpanel
DB_PASSWORD=changeme-strong-password

# JWT
JWT_SECRET=changeme-your-super-secret-jwt-key
JWT_REFRESH_SECRET=changeme-your-super-secret-refresh-key
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# API
VITE_API_URL=http://localhost:3000

# AI Assistant Configuration (Optional)
AI_ASSISTANT_ENABLED=false
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# Azure Content Safety Configuration (Optional)
AZURE_CONTENT_SAFETY_KEY=your-azure-content-safety-subscription-key
AZURE_CONTENT_SAFETY_ENDPOINT=https://your-region.cognitiveservices.azure.com/

# Email Configuration
# Resend (recomendado para producción)
RESEND_API_KEY=your-resend-api-key-here
EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@mundoworld.school
EMAIL_FROM_NAME="Mundo World School"

# SMTP (alternativo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@tuescuela.com
SMTP_PASS=your-email-password

# Admin default (CHANGE THESE IN PRODUCTION!)
# Use strong passwords with at least 12 characters
ADMIN_EMAIL=CHANGE_THIS_ADMIN_EMAIL@example.com
ADMIN_PASSWORD=CHANGE_THIS_USE_STRONG_PASSWORD_MIN_12_CHARS

# AI/LLM Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key-here
AI_MODEL=claude-3-5-haiku-20241022
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.7
AI_CACHE_TTL=3600

# Monitoring Configuration
PROMETHEUS_DEFAULT_METRICS_ENABLED=true
PROMETHEUS_PUSHGATEWAY_ENABLED=false
PROMETHEUS_PUSHGATEWAY_URL=http://localhost:9091
PROMETHEUS_PUSH_INTERVAL=30000

# Grafana Configuration
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123

# HuggingFace Configuration for Semantic Evaluation
HUGGINGFACE_API_TOKEN=your-huggingface-api-token-here
NLP_MODEL_NAME=PlanTL-GOB-ES/roberta-large-bne
NLP_CACHE_SIZE=1000
NLP_BATCH_SIZE=8
NLP_MAX_TEXT_LENGTH=512

# Google Drive API Configuration
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"
GOOGLE_SHARED_DRIVE_NAME="12. Plataforma (Recursos dicácticos compartidos)"

# Educational Resources Configuration
CURRENT_ACADEMIC_YEAR=2024-2025
AUTO_CREATE_FOLDERS=true
ARCHIVE_OLD_RESOURCES=true

# File Upload Limits (in bytes)
MAX_FILE_SIZE_PDF=52428800       # 50MB
MAX_FILE_SIZE_VIDEO=524288000    # 500MB
MAX_FILE_SIZE_IMAGE=10485760     # 10MB
MAX_FILE_SIZE_HTML=5242880       # 5MB
MAX_FILE_SIZE_DOCUMENT=20971520  # 20MB

# Upload Configuration
UPLOAD_CHUNK_SIZE=5242880        # 5MB chunks
CONCURRENT_CHUNKS=3              # Parallel chunks

# Notifications
NOTIFY_ON_NEW_RESOURCE=true
NOTIFY_ON_ASSIGNMENT=true

# Secretaría integration (internal docker network)
SECRETARIA_API_URL=http://mw-secretaria-api:3010/api
SECRETARIA_SERVICE_USER_ID=<uuid de un usuario con staff_role secretaria_admin>